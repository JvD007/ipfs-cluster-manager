# IPFS Cluster REST API endpoint (default 9094)
CLUSTER_API_URL=http://127.0.0.1:9094

# === Authenticatie — kies één van de drie opties ===

# OPTIE A (aanbevolen): Keycloak / OIDC met automatische token-refresh
# Vul KEYCLOAK_URL + REALM + CLIENT_ID in, plus óf USERNAME+PASSWORD,
# óf alleen CLIENT_SECRET (voor client_credentials grant).
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=
# Hoeveel seconden vóór expiry alvast refreshen (default 60)
KEYCLOAK_REFRESH_SKEW=60

# OPTIE B: Basic Auth (vereist basic_auth_credentials in Cluster service.json)
CLUSTER_USERNAME=
CLUSTER_PASSWORD=

# OPTIE C: Statisch JWT-token (handmatig vernieuwen — alleen voor korte tests)
CLUSTER_JWT=

# Voor self-signed TLS (typisch in on-prem k8s deployments) op false zetten
VERIFY_TLS=true
REQUEST_TIMEOUT=30

# Veiligheidslimieten
MAX_BULK_UNPIN=5000
REQUIRE_CONFIRM_TOKEN=true

# IPFS daemon restart via de IPFS API (POST /api/v0/shutdown).
# Kommagescheiden lijst van peer_naam=basis_url.
# De process manager (systemd/k8s) herstart de daemon automatisch na shutdown.
# Voorbeeld: ipfs-3=https://ford.example.eu/api/v0,ipfs-4=https://ford.example.eu/api/v0
IPFS_API_URLS=

# Restart-webhook — optioneel. Als ingevuld verschijnen ↻ Cluster-knoppen per peer.
# {peer_id} wordt vervangen door het Cluster peer ID.
# Voorbeeld voor Kubernetes: https://my-api/rollout-restart/{peer_id}
RESTART_WEBHOOK_URL=

# Web UI binding — laat op 127.0.0.1 staan tenzij je achter een reverse proxy zit
HOST=127.0.0.1
PORT=8765
